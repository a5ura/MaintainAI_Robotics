{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"maintainai-d1-local-contract",
 "main":"cloudflare/d1_bridge.mjs",
 "compatibility_date":"2026-10-30",
 "workers_dev":false,
 "preview_urls":false,
 "assets":{"directory":"frontend/dist","binding":"ASSETS","run_worker_first":["/__contract/*"],"not_found_handling":"single-page-application"},
 "vars":{"LOCAL_CONTRACT_ONLY":"1"},
 "d1_databases":[{"binding":"DB","database_name":"maintainai-local-only","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"cloudflare/migrations"}]
}
