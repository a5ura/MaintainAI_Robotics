{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintainai-local-feasibility",
  "main": "cloudflare/entry.py",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "vars":{"DEMO_READONLY":"0","DEMO_DAILY_REQUESTS":"2000","DEMO_DAILY_WRITES":"250","DEMO_DAILY_SNAPSHOT_BYTES":"67108864"},
  "preview_urls": false,
  "d1_databases": [{"binding":"DB","database_name":"maintainai-local-only","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"cloudflare/migrations"}],
  "assets": {"directory":"frontend/dist","binding":"ASSETS","run_worker_first":["/api/*"],"not_found_handling":"single-page-application"}
}
